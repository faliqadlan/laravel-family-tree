# ============================================================
# Docker Environment Configuration
# ============================================================
# Copy this file to .env when running with docker-compose:
#   cp .env.docker .env
#
# All service hostnames below match the docker-compose.yml
# service names (mysql, redis, mailpit) — do NOT use 127.0.0.1.
# ============================================================

APP_NAME="Liberu Genealogy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=liberu
DB_USERNAME=liberu
DB_PASSWORD=secret

# ── Cache / Session / Queue ──────────────────────────────────
# Redis-backed for all three so the app runs statelessly.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Mailpit — web UI at http://localhost:8025) ─────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL="contact@example.com"

# ── Laravel Octane (RoadRunner used by docker-compose) ───────
OCTANE_SERVER=roadrunner
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_TASK_WORKERS=auto
OCTANE_MAX_EXECUTION_TIME=30
OCTANE_MAX_REQUEST_SIZE=10485760
OCTANE_AUTO_RELOAD=false

# ── Docker / Container ───────────────────────────────────────
CONTAINER_MODE=http
WITH_HORIZON=false
WITH_SCHEDULER=true
RUNNING_MIGRATIONS_AND_SEEDERS=false

# ── Stripe (leave blank for local dev) ───────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly
STRIPE_PREMIUM_PRODUCT_ID=prod_premium

# ── Premium Features ─────────────────────────────────────────
PREMIUM_ENABLED=false
SUBSCRIPTION_PREMIUM_PRICE=2.99
SUBSCRIPTION_PREMIUM_INTERVAL=month
SUBSCRIPTION_PREMIUM_TRIAL_DAYS=14
SUBSCRIPTION_PREMIUM_STRIPE_PRICE_ID=price_premium_monthly
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
CASHIER_STRIPE_SUBSCRIPTION_DEFAULT_PRICE_ID=price_premium_monthly

# ── Social OAuth (optional — leave blank for local dev) ──────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/oauth/facebook/callback"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI="${APP_URL}/oauth/twitter/callback"

# ── AWS S3 (optional) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Pusher / Broadcasting (optional) ─────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Google Vision API (optional) ─────────────────────────────
GOOGLE_VISION_API_KEY=

# ── External Genealogy APIs (optional) ───────────────────────
MYHERITAGE_API_KEY=
MYHERITAGE_BASE_URL=https://api.myheritage.com/v1
MYHERITAGE_TIMEOUT=30
ANCESTRY_API_KEY=
ANCESTRY_BASE_URL=https://api.ancestry.com/v1
ANCESTRY_TIMEOUT=30
FAMILYSEARCH_API_KEY=
FAMILYSEARCH_BASE_URL=https://api.familysearch.org/platform
FAMILYSEARCH_TIMEOUT=30
